<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Strivea.ViewModels"
             xmlns:converters="using:Strivea.Converters"
             x:Class="Strivea.App">
    <Application.DataTemplates>
        <vm:ViewLocator />
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Margin" Value="5" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <converters:UniversalBoolConverter x:Key="BoolConverter" />
        <converters:FolderToChannelNameConverter x:Key="FolderToChannelNameConverter" />
        <converters:FolderToFileCountConverter x:Key="FolderToFileCountConverter" />
    </Application.Resources>
</Application>