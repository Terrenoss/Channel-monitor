<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Avalonia.Controls">
    <Design.PreviewWith>
        <controls:Window Width="800" Height="600" />
    </Design.PreviewWith>

    <Styles.Resources>
        <Thickness x:Key="ControlPadding">8</Thickness>
        <Thickness x:Key="ControlMargin">4</Thickness>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    </Style>
</Styles> 