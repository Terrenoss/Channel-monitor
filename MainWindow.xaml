<Window x:Class="AutoStreamRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Recorder" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF3D3D3D"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3D3D3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF3D3D3D"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Stream Recorder" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding CurrentAction}" Foreground="#FF007ACC"
                     Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}"
                     FontSize="14"/>
        </StackPanel>

        <!-- Contrôles -->
        <Border Grid.Row="1" Background="#FF2D2D2D" CornerRadius="4" Padding="15" Margin="0,10">
            <StackPanel>
                <TextBlock Text="URL du stream:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding StreamUrl}" Margin="0,0,0,10"/>
                <TextBlock Text="Supporte: YouTube, Twitch, Kick, Trovo, DLive, Facebook Gaming, Nimo TV, AfreecaTV, Bilibili, VK Play Live, Niconico et autres plateformes compatibles avec Streamlink" 
                         Foreground="#FFA0A0A0" FontSize="11" TextWrapping="Wrap"/>
            
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="Démarrer la surveillance" Command="{Binding MonitorCommand}"
                            Margin="0,0,10,0" FontWeight="Bold"
                        IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBooleanConverter}}"/>
                
                <Button Content="Arrêter" Command="{Binding StopMonitoringCommand}"
                            FontWeight="Bold" Background="#FFD32F2F"
                        Visibility="{Binding IsMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>
        </Border>

        <!-- Stats -->
        <Border Grid.Row="2" Background="#FF2D2D2D" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <TextBlock Text="{Binding CurrentRecordingStats}" FontWeight="Bold"/>
        </Border>

        <!-- Logs -->
        <Border Grid.Row="3" Background="#FF2D2D2D" CornerRadius="4" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <ToggleButton Content="Mode Debug" 
                                IsChecked="{Binding IsDebugMode}"
                                Margin="0,0,10,0"
                                Padding="10,5"/>
                    <Button Content="Copier les logs" Command="{Binding CopyLogsCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Effacer les logs" Command="{Binding ClearLogsCommand}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <ItemsControl ItemsSource="{Binding ActivityLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="5,2" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Barre de statut -->
        <StatusBar Grid.Row="4" Background="#FF2D2D2D">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar IsIndeterminate="{Binding IsWorking}" Width="100" Height="16"
                             Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>