<Window x:Class="AutoStreamRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Stream Recorder" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="YouTube Stream Recorder" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding CurrentAction}" Foreground="Blue"
                     Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Contrôles -->
        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="URL YouTube:" FontWeight="Bold"/>
            <TextBox Text="{Binding YoutubeUrl}" Margin="0,5" Padding="8"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button Content="Démarrer la surveillance" Command="{Binding MonitorCommand}"
                        Margin="0,0,10,0" Padding="15,5" FontWeight="Bold"
                        IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBooleanConverter}}"/>
                
                <Button Content="Arrêter" Command="{Binding StopMonitoringCommand}"
                        Padding="15,5" FontWeight="Bold" Background="#FFFF0000"
                        Visibility="{Binding IsMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Statistiques d'enregistrement -->
        <Border Grid.Row="2" Background="#FFEEEEDD" Margin="0,5" Padding="10,5" CornerRadius="5">
            <TextBlock Text="{Binding CurrentRecordingStats}" FontWeight="Bold" 
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Journal des logs -->
        <GroupBox Grid.Row="3" Header="Journal d'activité" Margin="0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copier" Command="{Binding CopyLogsCommand}" 
                            Margin="5" Padding="8,3" ToolTip="Copier les logs"/>
                    <Button Content="Effacer" Command="{Binding ClearLogsCommand}" 
                            Margin="5" Padding="8,3" ToolTip="Effacer les logs"/>
                </StackPanel>
                <ListView ItemsSource="{Binding ActivityLogs}" FontFamily="Consolas" FontSize="12">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </GroupBox>

        <!-- Barre de statut -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar IsIndeterminate="{Binding IsWorking}" Width="100" Height="16"
                             Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>