<Window x:Class="AutoStreamRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AutoStreamRec.Converters"
        Title="Stream Recorder" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:UniversalBoolConverter x:Key="BooleanToVisibilityConverter" 
                                         InverseBool="False" 
                                         ToVisibility="True"/>
        <converters:UniversalBoolConverter x:Key="InverseBooleanConverter" 
                                         InverseBool="True" 
                                         ToVisibility="False"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="YouTube Stream Recorder" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding CurrentAction}" Foreground="Blue"
                      Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Margin="0,10">
            <Button Content="Convertir TS en MP4" Command="{Binding ConvertCommand}"
                    Margin="0,5" Padding="15,8" FontWeight="Bold"/>
            
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="URL YouTube:" FontWeight="Bold"/>
                <TextBox Text="{Binding YoutubeUrl}" Margin="0,5" Padding="8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Button Content="Surveiller et Enregistrer" Command="{Binding MonitorCommand}"
                            Margin="0,0,10,0" Padding="15,8" FontWeight="Bold"
                            IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBooleanConverter}}"/>
                    
                    <Button Content="Arrêter la surveillance" Command="{Binding StopMonitoringCommand}"
                            Padding="15,8" FontWeight="Bold" Background="#FFFF0000"
                            Visibility="{Binding IsMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Activity Log -->
        <GroupBox Grid.Row="2" Header="Journal d'activité" Margin="0,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copier les logs" Command="{Binding CopyLogsCommand}" 
                            Margin="5" Padding="10,3" ToolTip="Copier tous les logs dans le presse-papier"/>
                    <Button Content="Effacer les logs" Command="{Binding ClearLogsCommand}" 
                            Margin="5" Padding="10,3" ToolTip="Effacer l'historique des logs"/>
                </StackPanel>
                <ListView ItemsSource="{Binding ActivityLogs}" FontFamily="Consolas" FontSize="12"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </GroupBox>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar IsIndeterminate="{Binding IsWorking}" Width="100" Height="16"
                             Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>