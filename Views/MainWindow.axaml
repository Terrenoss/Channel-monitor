<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strivea.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="using:Strivea.Converters"
        xmlns:sys="clr-namespace:System;assembly=netstandard"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Strivea.Views.MainWindow"
        Icon="/Assets/logo-strivea.ico"
        Title="Strivea"
        DataContext="{Binding}"
        x:Name="RootWindow"
        Width="1100" Height="700">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">
        <!-- Ligne 0 : URL du stream -->
        <TextBox Grid.Row="0" Watermark="URL du stream" Text="{Binding StreamUrl, Mode=TwoWay}" Margin="0,0,0,10" />

        <!-- Ligne 1 : Chemin d'enregistrement (modifiable + bouton de sélection) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,0,0,10">
            <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}" Watermark="Répertoire de sortie" Width="600" />
            <Button Command="{Binding BrowseOutputDirectoryCommand}" Width="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M10,2 L2,8 L2,18 L18,18 L18,8 Z M4,10 L16,10 L16,16 L4,16 Z" Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Ligne 2 : Logs (centre, prend tout l'espace restant) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ActivityLogs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Ligne 3 : Boutons en bas -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Command="{Binding CheckDependenciesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Data="M12,2A10,10 0 1,0 22,12A10,10 0 1,0 12,2ZM13,7H11V9H13V7ZM13,11H11V17H13V11Z" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Text="Vérifier les dépendances"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding StartMonitoringCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Data="M8,5v14l11-7z" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Text="Démarrer"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding StopMonitoringCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Data="M6,6h12v12H6z" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Text="Arrêter"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenTempFilesManagerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Data="M3,6v12a2,2 0 0,0 2,2h14a2,2 0 0,0 2-2V6H3zm2,0h14v12H5V6zm3,2v8h2v-8H8zm4,0v8h2v-8h-2z" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Text="Gérer les fichiers temporaires"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>