<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Strivea.Converters"
        xmlns:sys="clr-namespace:System;assembly=netstandard"
        x:Class="Strivea.Views.TempFilesManagerWindow"
        Title="Gestion des fichiers temporaires"
        Width="400" Height="500"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Chaînes avec fichiers Temp :" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding TempFoldersWithTs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                    <Button Tag="{Binding .}"
                            Click="OnChannelButtonClick"
                            HorizontalAlignment="Stretch"
                            Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Data="M10,2 L2,8 L2,18 L18,18 L18,8 Z M4,10 L16,10 L16,16 L4,16 Z" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="{Binding Path=., Converter={StaticResource FolderToChannelNameConverter}}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button HorizontalAlignment="Center" MinWidth="100" Padding="12,6" Margin="0,20,0,0" Click="OnCloseClick">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M6,6 L18,18 M6,18 L18,6" Stroke="White" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Fermer" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</Window> 